# Copy to backend/.env and fill in. Never commit .env.

# --- Monad / chain data -----------------------------------------------------
MONAD_RPC_URL=https://rpc.monad.xyz
# auto = Envio (if configured) -> Monad RPC ; also: envio | rpc | demo
DATA_SOURCE=auto
RPC_SCAN_BLOCKS=150
# Envio HyperSync indexed path (optional; check Envio docs for the Monad URL)
ENVIO_HYPERSYNC_URL=
ENVIO_API_TOKEN=

# --- Storage / config -------------------------------------------------------
DATABASE_URL=sqlite:///./potus.db
# Defaults to "services + tests + scripts + config/config/risk.yaml" when unset
RISK_CONFIG_PATH=

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto = real Gemini when key set ; mock = deterministic triage (recorded demo) ; off = force fallback
GEMINI_MODE=auto
GEMINI_TIMEOUT_SECONDS=6
GEMINI_TRIGGER_SCORE=0.35

# --- On-chain evidence (PotusRegistry) -------------------------------------
POTUS_REGISTRY_ADDRESS=
# Risk-oracle signer for updateRisk(). PoC only - production needs proper signing/attestation.
ORACLE_PRIVATE_KEY=

# --- API --------------------------------------------------------------------
CORS_ORIGINS=*
